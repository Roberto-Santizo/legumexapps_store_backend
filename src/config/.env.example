NODE_ENV=development
# One origin only. Production: set explicitly to the approved HTTPS frontend origin.
FRONTEND_URL=http://localhost:5173
PORT=3000
# SERVER_PORT is an optional local legacy fallback; Render PORT takes precedence.
DATABASE_URL=
# Remote/production DATABASE_URL requires explicit port and ?sslmode=verify-full.
# Optional PEM CA when the certificate is not already trusted by Node:
DATABASE_CA_CERT=
DB_SYNC_ALTER=false
# Default restricted. Set owner only when explicitly accepting elevated DB privileges.
DB_ROLE_POLICY=restricted
JWT_SECRET=
JWT_EXPIRES_IN=
# Optional initial application administrator for the access-control seeder (no interactive prompts):
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
# Previous names remain accepted; existing users/passwords are never overwritten:
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Administrative processes do not load this file. Inject the selected variables securely.
# No fallback from DEV/PROD_DATABASE_URL to DATABASE_URL is permitted.
DEV_DATABASE_URL=
PROD_DATABASE_URL=

# Credentials for the AWS S3 bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=

# Credentials for the email service
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
NOREPLY_USER=
